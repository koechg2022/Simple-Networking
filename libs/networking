    namespace std {
        template <> struct hash<networking::network_structures::connected_host::client_name> {
            size_t operator()(const networking::network_structures::connected_host::client_name& cn) const {
                size_t h1 = std::hash<std::string>{}(cn.hostname);
                size_t h2 = std::hash<std::string>{}(cn.portvalue);
                return h1 ^ (h2 << 1); // or use boost::hash_combine
            }
        };
    }

    namespace std {
        template <> struct hash<pollfd> {
            size_t operator()(const pollfd& this_poll) const {
                size_t socket_hash = std::hash<socket_type>{}(this_poll.fd);
                size_t event_hash = std::hash<short>{}(this_poll.events);
                return socket_hash ^ (event_hash << 1);
            }
        };
    }

