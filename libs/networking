        namespace network_structures {

            namespace connected_host {

                typedef struct client_name {
                    std::string hostname = "", portvalue = "";
                    
                    bool operator<(const struct client_name& other) const;
                } client_name;

                typedef struct client {
                    std::string hostname = "", portvalue = "";
                    socket_type connected_socket = invalid_socket;
                    secure_socket_type secure_socket = invalid_secure_socket;

                    struct sockaddr_storage address_info = empty_sockaddr();
                    socklen_t address_size = sizeof(address_info);

                    bool operator<(const client& other) const;

                    operator bool() const;
                } client;

                typedef struct server{
                    std::string hostname = "", portvalue = "";
                    context_type context = invalid_context;
                    secure_socket_type secure_socket = invalid_secure_socket;
                    socket_type connect_socket = invalid_socket;
                    
                    struct addrinfo* address_info = null;

                    bool operator<(const server& other) const;

                    operator bool() const;
                } server;

            }



            class host {

                protected:

                    
                    // For non secure connection
                    socket_type connect_socket;
                    struct addrinfo* address_information;
                    std::string host_name, port_value, cert_file, key_file;
                    bool tcp, was_init;
                    struct timeval timeout;

                    
                    // For secure connection
                    bool secure_, was_init_secure;
                    context_type context;


                    bool create_context_(bool server_);

                    /**
                        Create the address object of this host.

                        `note` : Returns the current host object, allowing for chaining.
                     */
                    bool create_address();

                    /**
                        Create the socket for this host machine.
                     */
                    bool create_socket();


                public:

                    host();

                    host(const std::string hostname, const std::string port, bool tcp = true, bool secure = false, struct timeval select_timeout = {0, 200}, const std::string cert_file = "cert.pem", const std::string key_file = "key.pem");

                    host(const host& other);

                    ~host();

                    host& operator=(const host& other);

                    virtual operator bool() const;
                    
                    /**
                        Get the status of whether or not the host creates secure connections or not.

                            * Returns `true` if the host makes secure conections, `false` if it doesn't.
                     */
                    bool secure() const;

                    /**
                            Change the host from a non secure host connection
                            to a secure host connection.

                            * `new_flag (const bool)` : A flag to set the set the host 
                                to secure or not secure.

                            * `note` : If the host is connected, then the host's connection 
                                    type is not changed.
                     */
                    host& secure(const bool new_flag = false);

                    /**
                        Change the hostname of the host.

                            * `new_host (const std::string)` : The new hostname of this host.
                            
                            * `new_host (const std::string)` : If the host is connected, then the hostname is not changed.
                     */
                    host& hostname(const std::string new_host);
                    
                    /**
                        Get the name of this host's `hostname`.
                     */
                    std::string hostname() const;
                    
                    /**
                        Get the conection socket that this host uses.
                     */
                    socket_type connection_socket() const;

                    /**
                        Close the host connection.
                     */
                    bool close_host();

            };

