

#if not defined(_MISC_FUNCTIONS_)
    #define _MISC_FUNCTIONS_
    
    #include "../headers/included"

namespace misc_functions {


    /**
        @brief Get the current time on this local system
        @return A `std::string` of the current time (date and time) on the system.
     */
    const std::string get_current_time();


    /**
        @brief Get the terminal's (for UNIX or cmd/powershell on WIN) width.
        @returns An `int` representing the Command line's width.
     */
    int get_terminal_width();


    /**
        @brief Get the terminal's (for UNIX or cmd/powershell on WIN) height.
        @returns An `int` representing the Command line's height.
     */
    int get_terminal_height();


    /**
        @brief Get the content of a file as a map with a key/value separator of the `delimiter`.
        @param file_name : (`const std::string&`) The file whose data is to be read.
        @param delimiter : (`const std::string`). Defaults to `:` This is what will separate the key from the value in each line.
        @returns a std::map<std::string, std::string> with the data from the `file_name` as key/value pairs in a `std::map`
    */
    std::map<std::string, std::string> get_file_data_map(const std::string& file_name, const std::string delimiter = ":");

    
    /**
        @brief Get the content of a directory with. The content will either be a 
        directory or a file. The map returned will have two keys:
            string_functions::_directory_ ("DIRECTORY")
            string_functions::_file_ ("FILE")
        
        Each key will map to a std::vector with all the files or directories 
            that are in the directory `directory_name`. If the directory doesn't exist, 
            then a map with the two keys and each key mapping to an empty std::vector is returned.

        @param directory_name (`const std::string&`) : The directory whose content is to be retrieved.

        @returns a std::map<std::string,std::vector<std::string> > with the files and directories of the `directory_name`.
    */
    std::map<std::string, std::vector<std::string> > get_directory_content(const std::string& file_name);


    /**
        @brief Get the content of the file `file_name` as a string.
        @param file_name (`const std::string`) : The file to be read from.
        @returns A `std::string` of the content of the file `file_name`
    */
    std::string get_file_data(const std::string file_name);


    /**
        @brief Get the directory path up to the directory passed in (including the directory passed in).
        @param dir_name (`const std::string`) : The directory to be found.
        @param ignore_case (`bool`) : Defaults to true. A flag specifying whether or not to ignore while
        getting the directory path.
        @returns The path up to and including `dir_name`, provided that `dir_name` exists down the path, 
        otherwise the complete path up to the current file is returned.
     */
    std::string get_base_directory(const std::string dir_name, bool ignore_case = true);



    /**
    *
    *   @brief Check if the keyboard has input available or not.
    *
    *
    *   @returns `true` if there is keyboard input, `false` otherwise.
    *
    */
    bool has_keyboard_input();

}

#endif