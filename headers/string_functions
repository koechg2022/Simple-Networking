



#if not defined(_string_functions_)
    #define _string_functions_

    
    #include <string>
    #include <set>
    #include <unordered_map>
    #include <map>
    #include <unordered_set>


    namespace string_functions {

        bool is_caps(const char c);

        bool is_lower(const char c);

        bool is_letter(const char c);

        bool is_number(const char c);

        bool same_char(const char a, const char b, const bool ignore_case = true);

        bool same_string(const std::string first, const std::string second, const bool ignore_case = true);

        char to_caps(const char c);

        char to_lower(const char c);

        bool set_contains(const std::string find, const std::set<std::string> the_set, const bool ignore_case = true);

        bool unordered_set_contains(const std::string find, const std::unordered_set<std::string> the_set, const bool ignore_case = true);

        template <typename data> bool map_contains(const std::string find, const std::map<std::string, data> the_map, const bool ignore_case = true) {
            
            for (const auto& [word, data_] : the_map) {
                if (string_functions::same_string(word, find, ignore_case)) {
                    return true;
                }
            }
            return false;
        }

        template <typename data> bool unordered_map_contains(const std::string find, const std::unordered_map<std::string, data> the_map, const bool ignore_case = true) {
            for (const auto& [word, data_] : the_map) {
                if (string_functions::same_string(word, find, ignore_case)) {
                    return true;
                }
            }
            return false;
        }

        /**
            @brief Remove excess strings at the beginning and end of
            `the_string`.

            @param the_string (std::string&) : The string to be stripped.
            @param to_remove (const std::string) : The string to be stripped.
         */
        void strip(std::string& the_string, const std::string to_remove, const bool ignore_case = true);


        /**
            @brief Replaces all instances of `to_replace` with `the_string`
            @param the_string (`std::string&) : The string to have parts of itself replaced.
            @param to_replace (`const std::string`) : The string to replace within `the_string`.
            @param replace_with (`const std::string`) : The string to replace `to_replace` with.
         */
        void replace_all(std::string& the_string, const std::string to_replace, const std::string replace_with);


        /**
            @brief Remove the first occurance of the `to_remove` substring within `the_string`
            @param the_string (`const std::string`) : The string to be searched through for `to_remove`
            @param to_remove (`const std::string`) : The string to remove from within `the_string`
            @param ignore_case (`const std::string`) : A bool flag specifying whether or not to ignore the cases 
            @returns A new `std::string` that is the same as `the_string` except it doesn't have the first instance of `to_remove`
            @note If there is no instance of `to_remove` within `the_string`, then the_string is returned.
        */
        std::string remove_first_of(const std::string the_string, const std::string to_remove, bool ignore_case = true);


        /**
            @brief Find the first occurance of the `to_find` substring within `the_string`
            @param the_string (`const std::string&`) : The string to be searched through for `to_find`
            @param to_find (`const std::string`) : The string to find from within `the_string`
            @param ignore_case (`const std::string`) : A bool flag specifying whether or not to ignore the cases 
            @returns A `size_t` that is the index of `the_string` with the first instance of `to_find`
            @note If there is no instance of `to_find` within `the_string`, then a size_t 
                std::string::npos is returned.
        */
        size_t first_index_of(const std::string& the_string, const std::string to_find, bool ignore_case = true);


        /**
            @brief Remove the last occurance of the `to_remove` substring within `the_string`
            @param the_string (`const std::string`) : The string to be searched through for `to_remove`
            @param to_remove (`const std::string`) : The string to remove from within `the_string`
            @param ignore_case (`const std::string`) : A bool flag specifying whether or not to ignore the cases 
            @returns A new `std::string` that is the same as `the_string` except it doesn't have the last instance of `to_remove`
            @note If there is no instance of `to_remove` within `the_string`, then the_string is returned.
        */
        std::string remove_last_of(const std::string the_string, const std::string to_remove, bool ignore_case = true);


        /**
            @brief Find the first occurance of the `to_find` substring within `the_string`
            @param the_string (`const std::string`) : The string to be searched through for `to_find`
            @param to_find (`const std::string`) : The string to find from within `the_string`
            @param ignore_case (`const std::string`) : A bool flag specifying whether or not to ignore the cases 
            @returns A `size_t` that is the index of `the_string` with the first instance of `to_find`
            @note If there is no instance of `to_find` within `the_string`, then a size_t 
                std::string::npos is returned.
        */
        size_t last_index_of(const std::string the_string, const std::string to_find, bool ignore_case = true);


        /**
            @brief Generate a string of length `length` and return it.
        */
        std::string generate_random_string(size_t length = 12);


    }



#endif