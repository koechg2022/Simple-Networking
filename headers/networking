        /**
            @brief A helper method used to send data to the host `host`.
            @param host (`networking::network_structures::host_connection`) : The host to send data to.
            @param the_message (`const data*`) : The data to send to `host`.
            @param byte_count (`const bytes`) : The size of the data to be sent.
            @param flags (`const int`) : Defaults to 0. The flags to use when sending a message 
            to the remote machine in a non-secure manner.
            @param timeout (`const std::chrono::duration<int>`) : Defaults to const std::chrono::seconds(10). 
            The maximum time to wait during attemps 
            to send data as they fail but are capable of trying again (false negative send failures).
            @returns A `networking::network_structures::host_report` with the sending report.

         */
        template <typename data> networking::network_structures::host_report send_message(networking::network_structures::host_connection host, const data* the_message, const bytes byte_count, const int flags = 0, const std::chrono::duration<int> timeout = std::chrono::seconds(10)) {
            if (not valid_socket(host.connect_socket)) {
                throw networking::exceptions::connection_failure("Host passed in to " + std::string(__FUNCTION__) + " is not connected to a remote machine.", unpack_exception_parameters(1));
            }



            // Call SSL_get_error() for details or check errno (macro socket_error).
                // Non-blocking SSL_get_error() will be < 1
                // SSL_write:
                //     Success	            bytes_ > 0                   :       Number of bytes written.
                //     Error	            bytes_ ≤ 0                   :       Call SSL_get_error() for details.
                //     Non-Blocking Issue	bytes_ == -1                 :       SSL_get_error() → SSL_ERROR_WANT_READ or SSL_ERROR_WANT_WRITE.
                //     Partial Write        bytes_ > 0 and < byte_count  : 	If SSL_MODE_ENABLE_PARTIAL_WRITE is enabled.
                
                // send:
                //     Success	            bytes_ ≥ 0               :   Number of bytes sent (may be partial).
                //     Error	            bytes_ ==-1              :   Check errno (e.g., ECONNRESET, EMSGSIZE).
                //     Non-Blocking Issue	bytes_ == -1             :   errno → EAGAIN or EWOULDBLOCK (buffer full).
                //     Partial Send	        0 ≤ bytes_ < byte_count	:   Check return value immediately; retry with remaining data.



            const bool _secure = valid_secure_socket(host.secure_connect_socket);
            bytes bytes_, total_ = 0;
            
            int bytes_error;//, block_write, block_read;
            #if defined(crap_os)
                const int block_read = (_secure) ? SSL_ERROR_WANT_READ : WSAWOULDBLOCK;
                const int block_write = (_secure) ? SSL_ERROR_WANT_WRITE : WSACONNRESET;
            #else
                const int block_write = (_secure) ? SSL_ERROR_WANT_WRITE : EWOULDBLOCK;
                const int block_read = (_secure) ? SSL_ERROR_WANT_READ : EAGAIN;
            #endif

            networking::network_structures::host_report the_answer;
            const auto start_time = std::chrono::steady_clock::now();
            while (total_ < byte_count) {
                bytes_ = (_secure) ? SSL_write(host.secure_connect_socket, reinterpret_cast<const char*>(the_message) + total_, byte_count - total_) :
                            send(host.connect_socket, reinterpret_cast<const char*>(the_message) + total_, byte_count - total_, flags);
                
                    
                if (bytes_ <= 0) {
                    
                    bytes_error = (_secure) ? SSL_get_error(host.secure_connect_socket, bytes_) : socket_error;

                    if (bytes_error == block_read or bytes_error == block_write) {
                        // blocking related
                        if (std::chrono::steady_clock::now() - start_time < timeout) {
                            continue;
                        }
                    }

                    if (not bytes_) {
                        // Connection was closed
                        total_ = (total_ > 1) ? total_ : 0;
                        break;
                    }
                    // An actual error occured
                    total_ = -1;
                    break;
                }
                // std::printf("\tAbout to update total_\n");
                total_ = total_ + bytes_;
            }
            // the_answer.host = host;
            // the_answer.byte_count = total_;
            // the_answer.success = (total_ == byte_count and total_ >= 1);

            // return the_answer;
            return {host, total_, (total_ == byte_count)};
        }

    }


