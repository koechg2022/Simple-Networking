            template <typename data> class host {

                protected:

                    // mutable std::mutex host_mutex_;

                    mutable std::mutex hostname_mutex_, port_mutex_;
                    std::string hostname_ = "", 
                        portvalue_ = default_port;
                    

                    mutable std::mutex active_address_mutex_, connect_address_mutex_;
                    struct addrinfo* connect_address_ = 0, *active_address_ = 0;
                    
                    mutable std::mutex connect_socket_mutex_;
                    socket_type connect_socket_ = invalid_socket;
                    
                    std::atomic<bool> tcp_ = true;
                        std::atomic<bool> was_init_ = networking::network_initialized();
                        std::atomic<bool> serving_ = true;
                        std::atomic<bool> block_ = true;
                    

                    bool tcp() const {
                        return this->tcp_.load();
                    }

                    data& tcp(const bool yes = true) {
                        
                        std::lock_guard lock(this->connect_socket_mutex_);
                        const bool connected_ = networking::socket_connected(this->connect_socket_),
                        valid = valid_socket(this->connect_socket_);
                        if (not connected_ or not valid) {
                            this->tcp_.store(yes);
                        }
                        return static_cast<data&>(*this);
                    }

                    bool server() const {
                        return this->serving_.load();
                    }

                    data& server(const bool yes = true) {
                        std::lock_guard<std::mutex> lock(this->connect_socket_mutex_);
                        if (not valid_socket(this->connect_socket_)) {
                            this->serving_.store(yes);
                        }
                        return static_cast<data&>(*this);
                    }

                    bool next_address() {
                        
                        std::lock_guard<std::mutex> lock(this->active_address_mutex_);
                        if (this->active_address_) {
                            const struct addrinfo* temp = this->active_address_;
                            this->active_address_ = this->active_address_->ai_next;
                            return this->active_address_ == temp->ai_next;
                        }
                        return this->active_address_;
                    }

                    void reset_address() {
                        std::scoped_lock locks(this->connect_address_mutex_, this->active_address_mutex_);
                        this->active_address_ = this->connect_address_;
                    }

                    bool create_connection_address() {
                        
                        std::unique_lock<std::mutex> lock_address(this->connect_address_mutex_);
                        if (not this->connect_address_) {
                            
                            if (not networking::network_initialized()) {
                                networking::initialize_network();
                                this->was_init_ = false;
                            }

                            std::lock_guard<std::mutex> host_lock(this->hostname_mutex_);
                            // Consider adding the this->serving_ check too. Just removed
                            if (this->hostname_.empty()) {
                                throw networking::exceptions::getaddrinfo_failure("Cannot retrieve address information without a hostname specified", unpack_exception_parameters(1));
                            }

                            std::lock_guard<std::mutex> port_lock(this->port_mutex_);
                            if (this->portvalue_.empty()) {
                                throw networking::exceptions::getaddrinfo_failure("Cannot retrieve address information without a port.", unpack_exception_parameters(1));
                            }

                            struct addrinfo hints;
                            std::memset(&hints, 0, sizeof(hints));
                            hints.ai_family = AF_UNSPEC;
                            hints.ai_socktype = (this->tcp_) ? SOCK_STREAM : SOCK_DGRAM;
                            hints.ai_flags = (this->serving_) ? AI_PASSIVE : 0;

                            // Ready to call getaddrinfo
                            if (getaddrinfo(this->hostname_.c_str(), this->portvalue_.c_str(), &hints, &this->connect_address_)) {
                                throw networking::exceptions::getaddrinfo_failure("Failed to retrieve address information for host \"" + this->hostname_ + "\". Error : \"" + std::string(socket_error_string(socket_error)) + "\"", unpack_exception_parameters(1));
                            }
                            if (this->serving_ and this->hostname_.empty()) {
                                this->hostname_ = default_hostname;
                            }
                            lock_address.unlock();
                            this->reset_address();
                            // std::printf("this->create_connection_address is about to return %s\n", (this->active_address_) ? "true" : "false");
                        }
                        return this->active_address_;
                    }

                    bool create_connection_socket() {
                        std::lock_guard<std::mutex> connect_socket_lock(this->connect_socket_mutex_);
                        if (not valid_socket(this->connect_socket_)) {

                            this->create_connection_address();
                            
                            this->reset_address(); // This is redundant
                            // this->active_address_ points to the front of this->connect_address_
                            
                            while (true) {

                                // Lock only when accessing this->active_address_
                                {
                                    std::lock_guard<std::mutex> active_lock(this->active_address_mutex_);

                                    if (not this->active_address_) {
                                        break;
                                    }

                                    this->connect_socket_ = socket(this->active_address_->ai_family, this->active_address_->ai_socktype, this->active_address_->ai_protocol);

                                }

                                if (valid_socket(this->connect_socket_)) {
                                    break;
                                }

                                this->next_address();

                            }

                            if (not valid_socket(this->connect_socket_)) {
                                throw networking::exceptions::create_connection_socket_failure("Failed to create the connection socket for this \"" + this->hostname_ + "\"", unpack_exception_parameters(8));
                            }
                        }
                        return valid_socket(this->connect_socket_);
                    }

                    bool close_host() {

                        std::lock_guard<std::mutex> connect_socket_lock(this->connect_socket_mutex_);
                        if (valid_socket(this->connect_socket_)) {
                            close_socket(this->connect_socket_); // close the socket
                            this->connect_socket_ = invalid_socket;
                        }

                        std::scoped_lock address_locks(this->connect_address_mutex_, this->active_address_mutex_);
                        if (this->connect_address_) {
                            freeaddrinfo(this->connect_address_);
                            this->connect_address_ = this->active_address_ = 0;
                        }

                        this->tcp_.store(true);
                        this->serving_.store(true);
                        this->block_.store(true);

                        if (not this->was_init_) networking::uninitialize_network();
                        this->was_init_.store(networking::network_initialized());

                        return not this->connect_address_ and not valid_socket(this->connect_socket_);
                    }
                
                    // Default constructor
                    host() {}

                    host(const std::string host_name, const std::string port_value = default_port, const bool use_tcp = true, const bool server_host = true) {
                        std::scoped_lock locks(this->hostname_mutex_, this->port_mutex_, this->active_address_mutex_, this->connect_address_mutex_, this->connect_socket_mutex_);
                        this->hostname_ = host_name;
                        this->portvalue_ = port_value;
                        this->tcp_.store(use_tcp);
                        this->serving_.store(server_host);
                        this->was_init_.store(networking::network_initialized());
                        if (not this->was_init_) {
                            networking::initialize_network();
                        }
                        this->active_address_ = this->connect_address_ = 0;
                    }

                    // Copy Constructor
                    host(const host& other) {
                        std::scoped_lock locks(this->hostname_mutex_, this->port_mutex_, this->active_address_mutex_, this->connect_address_mutex_, this->connect_socket_mutex_);
                        this->hostname_ = other.hostname_;
                        this->portvalue_ = other.portvalue_;
                        this->tcp_.store(other.tcp_.load());
                        this->serving_.store(other.serving_.load());
                        this->was_init_.store(other.was_init_.load());
                        this->block_.store(other.block_.load());

                        // TODO : Consider a deep copy.
                        this->connect_address_ = other.connect_address_;
                        this->connect_socket_ = other.connect_socket_;
                    }


                    // Move Constructor
                    host(host&& other) noexcept {
                        std::scoped_lock locks(this->hostname_mutex_, this->port_mutex_, this->active_address_mutex_, this->connect_address_mutex_, this->connect_socket_mutex_);
                        this->hostname_ = std::move(other.hostname_);
                        this->portvalue_ = std::move(other.portvalue_);
                        this->tcp_.store(other.tcp_.load());
                        this->serving_.store(other.serving_.load());
                        this->was_init_.store(other.was_init_.load());
                        this->block_.store(other.block_.load());
                        this->connect_address_ = other.connect_address_;
                        this->active_address_ = other.active_address_;
                        this->connect_socket_ = other.connect_socket_;

                        // Reset the values to defaults
                        other.hostname_ = other.portvalue_ = "";
                        other.connect_socket_ = invalid_socket;
                        other.active_address_ = other.active_address_ = 0;
                        other.tcp_.store(true);
                        other.serving_.store(true);
                        other.block_.store(true);
                        other.was_init_.store(networking::network_initialized());
                    }

                    // Destructor
                    ~host() {
                        this->close_host();
                    }


                    // Copy Assignment Operator
                    host& operator=(const host& other) {
                        if (this != &other) {
                            std::scoped_lock locks(this->hostname_mutex_, this->port_mutex_, this->active_address_mutex_, this->connect_address_mutex_, this->connect_socket_mutex_);
                            this->hostname_ = other.hostname_;
                            this->portvalue_ = other.portvalue_;
                            this->tcp_.store(other.tcp_.load());
                            this->serving_.store(other.serving_.load());
                            this->was_init_.store(other.was_init_.load());
                            this->block_.store(other.block_.load());
                            this->connect_address_ = other.connect_address_;
                            this->connect_socket_ = other.connect_socket_;
                            
                            if (other.connect_address_) {
                                if (other.hostname_.empty() or other.portvalue_.empty()) {
                                    int line_ = __LINE__ - 1;
                                    std::string message = "Cannot retrieve address information. Missing ";
                                    if (this->hostname_.empty() and not this->portvalue_.empty()) {
                                        line_ = __LINE__ - 1;
                                        message = message + "hostname";
                                    }
                                    else if (not this->hostname_.empty() and this->portvalue_.empty()) {
                                        line_ = __LINE__ - 1;
                                        message = message + "port";
                                    }
                                    else {
                                        message = message + "hostname and port";
                                    }
                                    throw exceptions::getaddrinfo_failure(message, true, __FILE__, line_, socket_error, __FUNCTION__);
                                }
                                this->create_connection_address();
                            }
                            
                            if (valid_socket(other.connect_socket_)) {
                                if (not this->create_connection_socket()) {
                                    throw networking::exceptions::create_connection_socket_failure("Failed to create the connection socket for the connection to the host \"" + this->hostname_ + "\"", unpack_exception_parameters(1));
                                }
                            }
                        }
                        return *this;
                    }


                    // Move Assignment Operator
                    host& operator=(host&& other) noexcept {
                        if (this != &other) {
                            std::scoped_lock locks(this->hostname_mutex_, this->port_mutex_, this->active_address_mutex_, this->connect_address_mutex_, this->connect_socket_mutex_);
                            this->hostname_ = std::move(other.hostname_);
                            this->portvalue_ = std::move(other.portvalue_);
                            this->tcp_.store(other.tcp_.load());
                            this->serving_.store(other.serving_.load());
                            this->was_init_.store(other.was_init_.load());
                            this->block_.store(other.block_.load());
                            this->connect_address_ = other.connect_address_;
                            this->active_address_ = other.active_address_;
                            this->connect_socket_ = other.connect_socket_;

                            // Reset the values to defaults
                            other.hostname_ = other.portvalue_ = "";
                            other.connect_socket_ = invalid_socket;
                            other.active_address_ = other.active_address_ = 0;
                            other.tcp_.store(true);
                            other.serving_.store(true);
                            other.block_.store(true);
                            other.was_init_.store(networking::network_initialized());
                        }
                        return *this;
                    }



                public:

                    /**
                        @brief Get the connection socket that is being used for communication.
                        @returns A `socket_type` reference.
                     */
                    socket_type& connection_socket() {
                        return this->connect_socket_;
                    }
                    
                    /**
                        @brief Get the hostname that this host is using.
                     */
                    std::string hostname() const {
                        return this->hostname_;
                    }

                    /**
                        @brief Set the hostname for this host.
                        @param new_host (`const std::string`) : The new hostname to set 
                        the host to.
                        @returns A `host` generic reference (either a `tcp_server` or a `tcp_client`) 
                        to the current host instance.
                     */
                    data& hostname(const std::string new_host) {
                        std::scoped_lock locks(this->connect_address_mutex_, this->connect_socket_mutex_, this->hostname_mutex_);
                        if (not this->connect_address_ and not valid_socket(this->connect_socket_)) {
                            this->hostname_ = new_host;
                        }
                        return static_cast<data&>(*this);
                    }

                    /**
                        @brief Get the port that this host is using.
                     */
                    std::string port() const {
                        return this->portvalue_;
                    }

                    /**
                        @brief Set the port for this host.
                        @param new_port (`const std::string`) : The new port for the host 
                        to use.
                        @returns A `host` generic reference (either a `tcp_server` or a `tcp_client`) 
                        to the current host instance.
                     */
                    data& port(const std::string new_port) {
                        std::scoped_lock locks(this->connect_address_mutex_, this->connect_socket_mutex_, this->port_mutex_);
                        if (not this->connect_address_ and not valid_socket(this->connect_socket_)) {
                            this->portvalue_ = new_port;
                        }
                        return static_cast<data&>(*this);
                    }

                    /**
                        @brief Retrieve the hostname for the generic host to use for connection.
                        @param adapter_name_options (const std::unordered_set<std::string>&`) : Defaults to 
                            {networking::network_address_families::rel_adapter}.
                            This holds all the adapters that should be be used for retrieving and setting the hostname.
                        @param family_name_options (`const std::unordered_set<std::string>&`) : Defaults to 
                            {networking::network_address_families::ip_version4_address_family, networking::network_address_families::ip_version6_address_family}.
                            This holds all the address families within the adapter_name_options that hold a desired IP address.
                        @returns A `host` generic reference (either a `tcp_server` or a `tcp_client`) 
                        to the current host instance.
                     */
                    data& retrieve_hostname(const std::unordered_set<std::string>& adapter_name_options = {networking::network_address_families::rel_adapter}, const std::unordered_set<std::string>& family_name_options = {networking::network_address_families::ip_version6_address_family, networking::network_address_families::ip_version4_address_family}) {
                        
                        std::lock_guard<std::mutex> host_lock(this->hostname_mutex_);

                        if (this->hostname_.empty()) {
                            
                            std::unordered_map<std::string, std::unordered_map<std::string, std::set<std::string> > > adapters = networking::machine_adapters();
                            std::string adapter_name = "", adapter_family = "";
                            
                            for (const std::string& name : adapter_name_options) {

                                if (string_functions::unordered_map_contains<std::unordered_map<std::string, std::set<std::string> > >(name, adapters)) {
                                    adapter_name = name;
                                    break;
                                }
                            }
                            
                            
                            if (not adapter_name.empty()) {

                                for (const std::string& name : family_name_options) {
                                    if (string_functions::unordered_map_contains<std::set<std::string> >(name, adapters[adapter_name])) {
                                        adapter_family = name;
                                        break;
                                    }
                                }
                            }

                            
                            if (not adapter_family.empty()) {
                                for (const std::string & name : adapters[adapter_name][adapter_family]) {
                                    if (name.empty()) {
                                        continue;
                                    }
                                    this->hostname_ = name;
                                    break;
                                }
                            }
                            
                            if (this->hostname_.empty()) {
                                this->hostname_ = std::string(default_hostname);
                            }
                        }
                        return static_cast<data&>(*this);
                    }

                    /**
                        @brief Check to see if the `host` blocking or not 
                        with it's connection sockets.
                     */
                    bool block() const {
                        return this->block_;
                    }

                    /**
                        @brief Set the `host` to block, or not block with it's connecting 
                        socket(s).
                        @param blocking (`const bool`) : The new setting. `true` will set the 
                        `host` blocking, and `false` will set it to non-blocking.
                        @returns A `host` generic reference (either a `tcp_server` or a `tcp_client`) 
                        to the current host instance.
                     */
                    data& block(const bool blocking) {
                        
                        this->block_.store(blocking);
                        std::lock_guard<std::mutex> socket_lock(this->connect_socket_mutex_);
                        const bool connected = networking::socket_connected(this->connect_socket_);
                        if (connected) {
                            networking::set_blocking(this->connect_socket_, this->block_);
                        }
                        return static_cast<data&>(*this);
                    }

            };

