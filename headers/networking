                        new client that has just connected.
                     */
                    networking::network_structures::client_connection new_client(const bool wait_to_connect = false, const struct timeval timeout = {0, 20000});

                    /**
                        @brief Get all the clients connected to this server.
                        @param all (`const bool`) : Defaults to `true`. If this value is true, then
                         all the clients connected to this server are returned. Otherwise, if `all` is false, 
                         then only the clients that are in a ready state are returned.
                        @returns A `std::unordered_set<networking::network_structures::client_connection>` with all the clients that adhere 
                        to the `all` parameter.
                     */
                    std::unordered_set<networking::network_structures::client_connection> clients(const bool all = true);

                    /**
                        @brief Update all the connections to the server, 
                        deleting all the connections that have expired.
                        @returns A reference to this current tcp server, allowing for chaining.
                     */
                    tcp_server& update();

                    /**
                        @brief Start the server.
                        @returns A reference to the current tcp server object to allow for chaining.
                     */
                    tcp_server& start();

                    /**
                        @brief Halt the server.
                        @returns `tcp_server` reference, allowing for chaining.
                     */
                    tcp_server& stop();

                    /**
                        @brief Broadcast a message to all clients.
                        @param message (`const void*`) : The message to send to all the connected clients.
                        @param byte_count (`bytes&`) : The number of bytes in message, to send.
                        @param flags (`const int`) : Defaults to `0`. The flags to use when broadcasting `message` as a non-secure.
                        @param disconnect (`const bool`) : Defaults to `true`. A flag specifying whether or not to disconnect failures.
                        @returns A `networking::network_structures::complete_report` with 
                        a report on all how all the client's messages were sent.
                     */
                    template <typename data> networking::network_structures::complete_report broadcast(data* the_message, const bytes byte_count, const int flags = 0, const bool disconnect = true, const std::chrono::duration<int> timeout = std::chrono::seconds(10)) {
                        
                        if (this->clients_.empty()) {
                            return {};
                        }
                        
                        networking::network_structures::complete_report the_answer;
                        networking::network_structures::host_report report;
                        for (const auto& [id, client] : this->clients_) {
                            
                            report = networking::send_message<data>(client, the_message, byte_count, flags, timeout);
                            report.success = (report.byte_count == byte_count and report.byte_count >= 0) ? true : report.success;
                            the_answer.add_report(report);
                        }

                        if (disconnect and the_answer.fails()) {
                            for (const auto& host : the_answer.reports) {
                                if (not host.success or not host.byte_count) {
                                    this->disconnect_client(host.host.host_information);
                                }
                            }
                        }

                        return the_answer;
                    }

                    /**
                        @brief Message the client passed in.
                        @param client (`const networking::network_structures::client_id`) : The client to message.
                        @param byte_count (`bytes&`) : The number of bytes in message, to send.
                        @param flags (`const int`) : Defaults to `0`. The flags to use when broadcasting `message` as a non-secure.
                        @param disconnect (`const bool`) : Defaults to `true`. A flag specifying whether or not to disconnect failures.
                        @returns A `networking::network_structures::complete_report` with 
                        a report on all how all the client's messages were sent.
                     */
                    template <typename data> networking::network_structures::complete_report message(const networking::network_structures::client_id client, data* the_message, const bytes byte_count, const int flags = 0, const bool disconnect = true, const std::chrono::duration<int> timeout = std::chrono::seconds(10)) {
    
                        networking::network_structures::complete_report the_answer;
                        networking::network_structures::host_report report;
                        std::vector<networking::network_structures::client_connection> connection;

                        bytes send_, total_;

                        for (const auto& [id, connect_info] : this->clients_) {

                            if (id.hostname.empty()) {
                                continue;
                            }

                            if (string_functions::same_string(id.hostname, client.hostname)) {

                                if (id.port.empty()) {
                                    // Found
                                    connection.push_back(connect_info);
                                    continue;
                                }
                                
                                if (string_functions::same_string(id.port, client.port)) {
                                    // If client.connection_time is empty, then the client is found. Message
                                    if (client.connection_time.empty()) {
                                        // Found
                                        connection.push_back(connect_info);
                                        continue;
                                    }

                                    if (string_functions::same_string(client.connection_time, id.connection_time)) {
                                        // Found
                                        connection.push_back(connect_info);
                                    }
                                    continue;
                                }
                            }
                        }

                        for (const auto& connect_info : connection) {
                            report = networking::send_message(connect_info, the_message, byte_count, flags, timeout);
                            report.success = (report.byte_count == byte_count and report.byte_count >= 0) ? true : report.success;
                            the_answer.add_report(report);
                        }

                        if (disconnect and the_answer.fails()) {
                            for (const auto& report : the_answer.reports) {
                                if (not report.success) {
                                    this->disconnect_client(report.host.host_information);
                                }
                            }
                        }

                        return the_answer;
                    }

                    /**
                        @brief Get the total number of connected clients.
                     */
                    unsigned long connections() const;

            };

            class tcp_client : public host<tcp_client> {
                private:
                    
                    std::atomic<bool> secure_ = {false};
                    std::atomic<bool> secure_was_init_ = {false};
                    std::atomic<bool> connected_ = {false};
                    std::atomic<bool> secure_fd_set_ = {false};
                    std::atomic<bool> secure_connected_ = {false};
                    std::atomic<bool> secure_handshook_= {false};
                    std::atomic<bool> sni_ = {true};
                    std::atomic<bool> server_name_indication_ = {false};

                    mutable std::mutex context_mutex_, secure_socket_mutex_, certificate_mutex_;
                    context_type context_ = invalid_context;
                    secure_socket_type secure_socket_ = invalid_secure_socket;
                    certificate_type certificate_ = invalid_certificate;

                    mutable std::mutex connect_time_mutex_, cipher_mutex_;
                    std::string connect_time_ = "", cipher_ = "";

                    bool create_context();

                    bool connect_socket(const std::chrono::duration<int> timeout = std::chrono::seconds(10));

                    bool create_secure_socket();

                    bool set_server_name_indication();

                    bool secure_file_descriptor();

                    bool secure_handshake(const std::chrono::duration<int> timeout = std::chrono::seconds(10));

                    bool get_cipher();

                    bool get_peer_certificate();


                public:

                    // Parameter Constructor
                    tcp_client(const std::string host_name, const std::string port = default_port, const bool secure = false, const bool sni = true);

                    // Copy Constructor
                    tcp_client(const tcp_client& other);

                    // Move Constructor
                    tcp_client(tcp_client&& other) noexcept;

                    // Destructor
                    ~tcp_client();

                    // Assignment Copy Operator
                    tcp_client& operator=(const tcp_client& other);

                    // Assignment Move Operator
                    tcp_client& operator=(tcp_client&& other) noexcept;

                    // Self Check Operator
                    operator bool() const;

                    /**
                        @brief Get the time when the connection was made with the server.
                        @returns A `std::string` with the time when the `tcp_client` connected to the server.
                     */
                    std::string connection_time() const;

                    /**
                        @brief Check if the `tcp_client` established (or will established) a secure connection.
                        @returns `true` if the `tcp_client` established 
                        (or will establish) a secure connection, `false` otherwise.
                     */
                    bool secure() const;

                    /**
                        @brief Change the `tcp_client` to use a secure or a 
                        non-secure connection, depending on what `set_secure` 
                        is set to.
                        @param set_secure (`const bool`) : The flag to specify 
                        whether or not to make the `tcp_client` establish a secure connection 
                        or not.
                        @returns A reference to this `tcp_client` instance which allows for 
                        chaining.
                     */
                    tcp_client& secure(const bool set_secure);

                    /**
                        @brief Start the `tcp_client` and establish a connection with the server 
                        associated with the host for this `tcp_client`.
                        @param timeout (`const std::chrono::duration<int>`) : Defaults to 10 seconds. This is the 
                        wait time that the `tcp_client` will wait a maximum of while trying ot establish a secure handshake.
                        @returns A reference to this `tcp_client` instance which allows for 
                        chaining.
                     */
                    tcp_client& start(const std::chrono::duration<int> timeout = std::chrono::seconds(10));

                    /**
                        @brief Stop the `tcp_client`, disconnecting the communication.
                        @returns A reference to this `tcp_client` instance which allows for 
                        chaining.
                     */
                    tcp_client& stop();

                    /**
                        @brief Get the subject name that the `tcp_client` uses 
                        for a secure connection with the remote host.
                        @returns A `std::string` with the subject name 
                        of the secure connection certificate.
                     */
                    std::string get_subject();

                    /**
                        @brief Get the issuer name that the `tcp_client` uses 
                        for a secure connection with the remote host.
                        @returns A `std::string` with the issuer name 
                        of the secure connection certificate.
                     */
                    std::string get_issuer();

                    /**
                        @brief Check if here is a message from the server or not.
                        @returns `true` if there is a message from the connected server, `false` otherwise.
                     */
                    bool message();

                    /**
                        @brief Send a message to the connected server machine.
                        
                        @param msg (`data*`) : The data to be sent. This is a generic data type pointer holding 
                        the data to be sent.

                        @param length (`const bytes`) : The length of the pointer with data to be sent.

                        @param flags (`const int`) : Defaults to 0, The flags to use while sending data to the connected machine. 
                        This is only useful when sending data in a non-securely connected machine.

                        @param timeout (`const std::chrono::duration<int>`) : Defaults to std::chrono::seconds(10). The maximum wait time that this 
                        client should spend while trying to send data. If it this timeout time is exceeded and the data is not sent, 
                        a failure host_report is sent.

                        @returns A `networking::network_structures::host_report` With a status of the current connection information, the total 
                        number of bytes, and a flag specifying whether the message was successfully sent or not.

                     */
                    template <typename data> networking::network_structures::host_report message(const data* msg, const bytes length, const int flags = 0, const std::chrono::duration<int> timeout = std::chrono::seconds(10)) {
                        
                        if (not std::is_const_v<data>) {
                            throw networking::exceptions::unexpected_failure("Error. To send a message, a constant data type must be passed into the message method.", unpack_exception_parameters(1));
                        }

                        if (not *this) {
                            return {};
                        }

                        // Connected to remote machine. This should work now.
                        networking::network_structures::host_connection remote;
                        remote.host_information = {this->hostname_, this->portvalue_, this->connect_time_};
                        remote.secure_connect_socket = this->secure_socket_;
                        remote.connect_socket = this->connect_socket_;
                        
                        return networking::send_message<data>(remote, msg, length, flags, timeout);
                    }

                    /**
                        @brief This method receives data from the connected remote machine.

                        @param msg (`data*`) : The data to be sent. This is a generic data type pointer holding 
                        the buffer space to receive the data.

                        @param length (const bytes`) : This is the length of the buffer space that will receive the data.

                        @param flags (`const int`) : Defaults to 0. This is the flag that is to be used while receiving data from the 
                        the connected machine. This is only useful when receiving data from a non-securely connected machine.

                        @param timeout (`const std::chrono::duration<int>`) : Defaults to std::chrono::seconds(10). This is the maximum wait time that 
                        this client should spend while trying to receive data. If this amount of time is exceeded and the data is not received such that 
                        the connection is no longer receiving data, the connection is closed, or there was an error, then a failure is returned.

                        @returns A `networking::network_structures::host_report` With a status of the current connection information, the totla 
                        number of bytes received, and a flag specifying whether a message was successfully received or not.
                     */
                    template <typename data> networking::network_structures::host_report message(data* msg, const bytes length, const int flags = 0, const std::chrono::duration<int> timeout = std::chrono::seconds(10)) {
                        
                        if (std::is_const_v<data>) {
                            throw networking::exceptions::unexpected_failure("Error. To receive a message, the pointer passed into message cannot be of `const` data type.", unpack_exception_parameters(1));
                        }

                        
                        if (not *this) {
                            return {};
                        }

                        // Connected to remote machine. This should work now.
                        networking::network_structures::host_connection remote;
                        remote.host_information = {this->hostname_, this->portvalue_, this->connect_time_};
                        remote.secure_connect_socket = this->secure_socket_;
                        remote.connect_socket = this->connect_socket_;

                        int byte_error;
                        #if defined(crap_os)
                            const int block_read = (this->secure_) ? SSL_ERROR_WANT_READ : WSAWOULDBLOCK;
                            const int block_write = (this->secure_) ? SSL_ERROR_WANT_WRITE : WSACONNRESET;
                        #else
                            const int block_write = (this->secure_) ? SSL_ERROR_WANT_WRITE : EWOULDBLOCK;
                            const int block_read = (this->secure_) ? SSL_ERROR_WANT_READ : EAGAIN;
                        #endif
                        bytes byte_chunk, total_bytes = 0;

                        networking::network_structures::host_report the_answer;
                        the_answer.host = remote;

                        const auto start_time = std::chrono::steady_clock::now();
                        while (*this and (std::chrono::steady_clock::now() - start_time < timeout)) {
                            byte_error = 0;
                            byte_chunk = (this->secure_) ? SSL_read(this->secure_socket_, reinterpret_cast<char*>(msg) + total_bytes, length - total_bytes) :
                                        recv(this->connect_socket_, reinterpret_cast<char*>(msg) + total_bytes, length - total_bytes, flags);
                            
                            if (byte_chunk < 1) {
                                byte_error = (this->secure_) ? SSL_get_error(this->secure_socket_, byte_chunk) : socket_error;

                                if (byte_error == block_read or byte_error == block_write) continue;

                                // Connection was either closed 
                                if (not byte_chunk) break;
                                
                                
                                // or an actual error occured.
                                
                                // To track the errors
                                if (byte_chunk < 0) byte_error = byte_error;

                                // std::printf("Inside error branch of receiving message method. byte_chunk is \"%ld\"\n", byte_chunk);
                                break;
                            }

                            total_bytes = total_bytes + byte_chunk;
                            
                            // Out of buffer space
                            if (total_bytes == length) break;

                            
                            if (not this->message()) break;
                            
                        }

                        
                        the_answer.byte_count = total_bytes;
                        the_answer.success = (0 < total_bytes);

                        return the_answer;
                    }

                    /**
                        @brief Get the connection information that this `tcp_client` is using 
                        for it's connection to the remote server.
                        @returns A `networking::network_structures::server_connection` 
                        with the connection information that is being used to 
                        communicate with the remote host.
                     */
                    networking::network_structures::server_connection connection_information() const;


                    /**
                        @brief Get the status of the client regarding whether or not to set the Server Name Indication.
                        @returns `true` if this client is currently set up to resolve the server name indication, `false` otherwise.
                     */
                    bool server_name_indication();


